{
  "name": "cairn-browser-extension",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Collect links and notes into Cairn Share from your browser.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "test:browser": "playwright test",
    "test:firefox": "node test/firefox-smoke.mjs",
    "verify": "npm test && npm run build && npm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "esbuild": "0.25.12",
    "jszip": "3.10.1"
  },
  "dependencies": {
    "defuddle": "0.19.4",
    "dompurify": "3.4.16",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2"
  }
}
